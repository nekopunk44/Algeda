@model Web.Models.Dashboard.AdminRealtorRequestsViewModel
@using Web.Models.Dashboard
@{
    ViewData["Title"] = "Заявки риелторов";
    var activeMenu = (string?)ViewData["AdminActive"] ?? string.Empty;
}

<div class="row g-3">
    <div class="col-xl-3 col-lg-4">
        <partial name="_Sidebar" model="activeMenu" />
    </div>
    <div class="col-xl-9 col-lg-8">
        <section class="card border-0 shadow-sm mb-3">
            <div class="card-body">
                <h1 class="h4 mb-1">Заявки риелторов</h1>
                <div class="text-muted mb-3">Модерация заявок на регистрацию риелторов.</div>

                <form method="get" asp-action="RealtorRequests" class="row g-2 align-items-end rounded-3 border bg-light p-3">
                    <div class="col-lg-7">
                        <label class="form-label">Поиск заявки</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-search"></i></span>
                            <input type="text"
                                   name="search"
                                   value="@Model.Search"
                                   class="form-control"
                                   placeholder="ФИО, телефон, почта или ID" />
                        </div>
                    </div>
                    <div class="col-sm-5 col-lg-3">
                        <label class="form-label">Статус</label>
                        <select name="status" class="form-select">
                            <option value="Pending" selected="@(Model.Status == "Pending" ? "selected" : null)">Ожидают решения</option>
                            <option value="Approved" selected="@(Model.Status == "Approved" ? "selected" : null)">Одобренные</option>
                            <option value="Rejected" selected="@(Model.Status == "Rejected" ? "selected" : null)">Отклоненные</option>
                            <option value="All" selected="@(Model.Status == "All" ? "selected" : null)">Все</option>
                        </select>
                    </div>
                    <div class="col-sm-7 col-lg-2">
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary flex-fill">Найти</button>
                            <a asp-action="RealtorRequests" class="btn btn-outline-secondary">Сброс</a>
                        </div>
                    </div>
                </form>
            </div>
        </section>

        @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
        {
            <div class="alert alert-success">@Model.SuccessMessage</div>
        }

        @if (Model.ApiError is not null)
        {
            <partial name="_ApiErrorAlert" model="Model.ApiError" />
        }

        <section class="card border-0 shadow-sm">
            <div class="card-body">
                @if (Model.Requests.Count == 0)
                {
                    <div class="alert alert-light border mb-0">Заявок не найдено.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle">
                            <thead>
                                <tr>
                                    <th>Кандидат</th>
                                    <th>Контакты</th>
                                    <th>Статус</th>
                                    <th>Решение</th>
                                    <th>Действия</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var request in Model.Requests)
                                {
                                    var isPending = string.Equals(request.Status, "Pending", StringComparison.OrdinalIgnoreCase);

                                    <tr>
                                        <td>
                                            <div class="fw-semibold">@request.FullName</div>
                                            <div class="small text-muted">Создана: @request.CreatedDate.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</div>
                                        </td>
                                        <td>
                                            <div>@request.Email</div>
                                            <div class="small text-muted">@request.PhoneNumber</div>
                                        </td>
                                        <td>
                                            <span class="badge @DashboardValueDisplay.RealtorRequestBadgeClass(request.Status)">
                                                @DashboardValueDisplay.RealtorRequestStatus(request.Status)
                                            </span>
                                        </td>
                                        <td>
                                            @if (request.ReviewedAt.HasValue)
                                            {
                                                <div class="small">@request.ReviewedAt.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</div>
                                            }
                                            <div class="small text-muted">@(string.IsNullOrWhiteSpace(request.ReviewComment) ? "—" : request.ReviewComment)</div>
                                        </td>
                                        <td>
                                            @if (isPending)
                                            {
                                                <div class="d-grid gap-2" style="min-width:220px;">
                                                    <form asp-action="ApproveRealtorRequest" method="post" class="d-flex gap-2">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="requestId" value="@request.Id" />
                                                        <input type="text" name="comment" class="form-control form-control-sm" placeholder="Комментарий (опционально)" />
                                                        <button type="submit" class="btn btn-sm btn-outline-success">Одобрить</button>
                                                    </form>
                                                    <form asp-action="RejectRealtorRequest" method="post" class="d-flex gap-2">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="requestId" value="@request.Id" />
                                                        <input type="text" name="comment" class="form-control form-control-sm" placeholder="Причина отказа" />
                                                        <button type="submit" class="btn btn-sm btn-outline-danger">Отклонить</button>
                                                    </form>
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">Действия недоступны</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </section>
    </div>
</div>

@model Web.Models.RealtorEfficiency.AdminRealtorAnalyticsViewModel
@using Web.Models.Dashboard
@{
    ViewData["Title"] = "Эффективность риелторов";
    var activeMenu = (string?)ViewData["AdminActive"] ?? string.Empty;
    var selectedRealtorId = Model.SelectedRealtorId;
}

<style>
    body.modal-open {
        overflow-y: scroll;
        padding-right: 0 !important;
    }
</style>

<div class="row g-3">
    <div class="col-xl-3 col-lg-4">
        <partial name="_Sidebar" model="activeMenu" />
    </div>
    <div class="col-xl-9 col-lg-8">
        <section class="card border-0 shadow-sm mb-3">
            <div class="card-body">
                <h1 class="h4 mb-1">Эффективность риелторов</h1>
                <div class="text-muted">CTS (клиентская оценка) и APS (админская оценка) с детализацией и трендом.</div>
            </div>
        </section>

        @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
        {
            <div class="alert alert-success">@Model.SuccessMessage</div>
        }

        @if (Model.ApiError is not null)
        {
            <partial name="_ApiErrorAlert" model="Model.ApiError" />
        }

        <section class="card border-0 shadow-sm mb-3">
            <div class="card-body">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                    <h2 class="h6 text-uppercase text-muted mb-0">Список риелторов</h2>
                    <span class="small text-muted">Всего: @Model.RealtorsTotalCount</span>
                </div>
                <form asp-action="RealtorAnalytics" method="get" class="row g-2 align-items-end rounded-3 border bg-light p-3 mb-3">
                    <div class="col-lg-7">
                        <label class="form-label">Поиск риелтора</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-search"></i></span>
                            <input type="text"
                                   name="search"
                                   class="form-control"
                                   value="@Model.Search"
                                   placeholder="ФИО, телефон, почта или ID" />
                        </div>
                    </div>
                    <div class="col-sm-5 col-lg-3">
                        <label class="form-label">Уровень</label>
                        <select name="level" class="form-select">
                            <option value="">Все уровни</option>
                            <option value="Junior" selected="@(Model.Level == "Junior" ? "selected" : null)">Junior</option>
                            <option value="Standard" selected="@(Model.Level == "Standard" ? "selected" : null)">Standard</option>
                            <option value="Top" selected="@(Model.Level == "Top" ? "selected" : null)">Top</option>
                        </select>
                    </div>
                    <div class="col-sm-7 col-lg-2">
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary flex-fill">Найти</button>
                            <a asp-action="RealtorAnalytics" class="btn btn-outline-secondary">Сброс</a>
                        </div>
                    </div>
                </form>
                @if (Model.Realtors.Count == 0)
                {
                    <div class="alert alert-light border mb-0">По фильтрам риелторы не найдены.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Риелтор</th>
                                    <th>Уровень</th>
                                    <th>Режим</th>
                                    <th>Сделок</th>
                                    <th class="text-end">Действия</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var realtor in Model.Realtors)
                                {
                                    var modalId = $"levelMode{realtor.Id:N}";
                                    var isSelected = selectedRealtorId == realtor.Id;
                                    <tr class="@(isSelected ? "table-primary" : null)">
                                        <td>
                                            <div class="fw-semibold">@realtor.FullName</div>
                                            <div class="small text-muted">@realtor.PhoneNumber@(string.IsNullOrWhiteSpace(realtor.Email) ? string.Empty : $" | {realtor.Email}")</div>
                                        </td>
                                        <td>@DashboardValueDisplay.RealtorLevel(realtor.Level)</td>
                                        <td>
                                            <span class="badge @(realtor.IsLevelManuallyAssigned ? "text-bg-warning" : "text-bg-success")">
                                                @(realtor.IsLevelManuallyAssigned ? "Ручной" : "Авто")
                                            </span>
                                        </td>
                                        <td>@realtor.DealsThisMonth</td>
                                        <td class="text-end">
                                            <div class="d-inline-flex flex-wrap justify-content-end gap-2">
                                                <a asp-action="RealtorAnalytics"
                                                   asp-route-realtorId="@realtor.Id"
                                                   asp-route-search="@Model.Search"
                                                   asp-route-level="@Model.Level"
                                                   asp-route-realtorPage="@Model.RealtorsPage"
                                                   asp-route-feedbackPage="1"
                                                   asp-route-scorePage="1"
                                                   class="btn @(isSelected ? "btn-primary" : "btn-outline-primary") btn-sm">Показать</a>
                                                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#@modalId">
                                                    Уровень
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (Model.RealtorsTotalPages > 1)
                    {
                        <nav class="mt-3" aria-label="Пагинация риелторов">
                            <ul class="pagination pagination-sm mb-0 justify-content-end">
                                @for (var p = 1; p <= Model.RealtorsTotalPages; p++)
                                {
                                    <li class="page-item @(p == Model.RealtorsPage ? "active" : null)">
                                        <a class="page-link"
                                           asp-action="RealtorAnalytics"
                                           asp-route-realtorId="@Model.SelectedRealtorId"
                                           asp-route-search="@Model.Search"
                                           asp-route-level="@Model.Level"
                                           asp-route-realtorPage="@p"
                                           asp-route-feedbackPage="@Model.FeedbackPage"
                                           asp-route-scorePage="@Model.ScoreHistoryPage">@p</a>
                                    </li>
                                }
                            </ul>
                        </nav>
                    }
                }
            </div>
        </section>

        @foreach (var realtor in Model.Realtors)
        {
            var modalId = $"levelMode{realtor.Id:N}";
            <div class="modal fade" id="@modalId" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                        <form asp-action="UpdateRealtorLevelMode" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="realtorId" value="@realtor.Id" />
                            <input type="hidden" name="search" value="@Model.Search" />
                            <input type="hidden" name="level" value="@Model.Level" />
                            <input type="hidden" name="realtorPage" value="@Model.RealtorsPage" />
                            <input type="hidden" name="feedbackPage" value="@Model.FeedbackPage" />
                            <input type="hidden" name="scorePage" value="@Model.ScoreHistoryPage" />
                            <div class="modal-header">
                                <h5 class="modal-title">Уровень риелтора</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
                            </div>
                            <div class="modal-body">
                                <div class="mb-3">
                                    <div class="fw-semibold">@realtor.FullName</div>
                                    <div class="small text-muted">Текущий уровень: @DashboardValueDisplay.RealtorLevel(realtor.Level)</div>
                                </div>
                                <div class="form-check form-switch mb-3">
                                    <input class="form-check-input"
                                           type="checkbox"
                                           role="switch"
                                           id="manualLevel@realtor.Id"
                                           name="isLevelManuallyAssigned"
                                           value="true"
                                           @(realtor.IsLevelManuallyAssigned ? "checked" : null) />
                                    <label class="form-check-label" for="manualLevel@realtor.Id">Отключить автоматическую смену уровня</label>
                                </div>
                                <label class="form-label">Уровень при ручном режиме</label>
                                <select name="manualLevel" class="form-select">
                                    <option value="Junior" selected="@(realtor.Level == "Junior" ? "selected" : null)">Junior</option>
                                    <option value="Standard" selected="@(realtor.Level == "Standard" ? "selected" : null)">Standard</option>
                                    <option value="Top" selected="@(realtor.Level == "Top" ? "selected" : null)">Top</option>
                                </select>
                                <div class="form-text">Если убрать галочку, уровень снова будет рассчитываться автоматически.</div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Отмена</button>
                                <button type="submit" class="btn btn-primary">Сохранить</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        }

        @if (Model.SelectedRealtor is null)
        {
            <section class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="alert alert-light border mb-0">Выберите риелтора для просмотра аналитики.</div>
                </div>
            </section>
        }
        else if (Model.LatestScore is null)
        {
            <section class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="alert alert-light border mb-0">Для выбранного риелтора пока нет рассчитанной оценки.</div>
                </div>
            </section>
        }
        else
        {
            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <section class="card border-0 shadow-sm h-100">
                        <div class="card-body">
                            <div class="small text-muted">Оценка доверия клиента (CTS)</div>
                            <div class="display-6">@Model.LatestScore.ClientTrustScore.ToString("F2")</div>
                            <div class="small text-muted">
                                Тренд: @(Model.ClientTrustTrendDelta.HasValue ? $"{Model.ClientTrustTrendDelta.Value:+0.0;-0.0;0.0}" : "недостаточно данных")
                            </div>
                        </div>
                    </section>
                </div>
                <div class="col-md-6">
                    <section class="card border-0 shadow-sm h-100">
                        <div class="card-body">
                            <div class="small text-muted">Оценка эффективности для админа (APS)</div>
                            <div class="display-6">@Model.LatestScore.AdminPerformanceScore.ToString("F2")</div>
                            <div class="small text-muted">
                                Тренд: @(Model.AdminPerformanceTrendDelta.HasValue ? $"{Model.AdminPerformanceTrendDelta.Value:+0.0;-0.0;0.0}" : "недостаточно данных")
                            </div>
                        </div>
                    </section>
                </div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-lg-6">
                    <section class="card border-0 shadow-sm h-100">
                        <div class="card-body">
                            <h2 class="h6 text-uppercase text-muted">Детализация CTS</h2>
                            <ul class="list-group list-group-flush">
                                <li class="list-group-item d-flex justify-content-between px-0">
                                    <span>Оценка сервиса клиента</span>
                                    <strong>@Model.LatestScore.ClientTrustBreakdown.ClientServiceScoreComponent.ToString("F2")</strong>
                                </li>
                                <li class="list-group-item d-flex justify-content-between px-0">
                                    <span>Штраф по жалобам</span>
                                    <strong>@Model.LatestScore.ClientTrustBreakdown.ComplaintPenaltyComponent.ToString("F2")</strong>
                                </li>
                            </ul>
                        </div>
                    </section>
                </div>
                <div class="col-lg-6">
                    <section class="card border-0 shadow-sm h-100">
                        <div class="card-body">
                            <h2 class="h6 text-uppercase text-muted">Детализация APS</h2>
                            <ul class="list-group list-group-flush">
                                <li class="list-group-item d-flex justify-content-between px-0">
                                    <span>Качество заполнения объектов</span>
                                    <strong>@Model.LatestScore.AdminPerformanceBreakdown.PropertyDataQualityComponent.ToString("F2")</strong>
                                </li>
                                <li class="list-group-item d-flex justify-content-between px-0">
                                    <span>Процессная дисциплина</span>
                                    <strong>@Model.LatestScore.AdminPerformanceBreakdown.WorkflowDisciplineComponent.ToString("F2")</strong>
                                </li>
                                <li class="list-group-item d-flex justify-content-between px-0">
                                    <span>Результативность</span>
                                    <strong>@Model.LatestScore.AdminPerformanceBreakdown.BusinessResultComponent.ToString("F2")</strong>
                                </li>
                                <li class="list-group-item d-flex justify-content-between px-0">
                                    <span>Репутационные риски</span>
                                    <strong>@Model.LatestScore.AdminPerformanceBreakdown.ReputationRiskComponent.ToString("F2")</strong>
                                </li>
                            </ul>
                        </div>
                    </section>
                </div>
            </div>

            <section class="card border-0 shadow-sm mb-3">
                <div class="card-body">
                    <h2 class="h6 text-uppercase text-muted mb-3">Жалобы на риелтора</h2>
                    <div class="row g-2 mb-3">
                        <div class="col-md-3 col-6"><div class="small text-muted">Всего</div><div class="fw-semibold">@Model.ComplaintStats.TotalCount</div></div>
                        <div class="col-md-3 col-6"><div class="small text-muted">Открытые</div><div class="fw-semibold">@Model.ComplaintStats.OpenCount</div></div>
                        <div class="col-md-3 col-6"><div class="small text-muted">В работе</div><div class="fw-semibold">@Model.ComplaintStats.InProgressCount</div></div>
                        <div class="col-md-3 col-6"><div class="small text-muted">Решены</div><div class="fw-semibold">@Model.ComplaintStats.ResolvedCount</div></div>
                    </div>
                    <div class="small text-muted mb-3">
                        Подтверждены: @Model.ComplaintStats.ConfirmedCount,
                        частично подтверждены: @Model.ComplaintStats.PartiallyConfirmedCount,
                        не подтверждены: @Model.ComplaintStats.NotConfirmedCount
                    </div>
                    @if (Model.ComplaintStats.RecentComplaints.Count == 0)
                    {
                        <div class="alert alert-light border mb-0">Жалоб на этого риелтора нет.</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Дата</th>
                                        <th>Категория</th>
                                        <th>Статус</th>
                                        <th>Вердикт</th>
                                        <th>Тема</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var complaint in Model.ComplaintStats.RecentComplaints)
                                    {
                                        <tr>
                                            <td class="text-nowrap">@complaint.CreatedDate.ToString("dd.MM.yyyy HH:mm")</td>
                                            <td>@DashboardValueDisplay.ComplaintCategory(complaint.Category)</td>
                                            <td>@DashboardValueDisplay.ComplaintStatus(complaint.Status)</td>
                                            <td>@DashboardValueDisplay.ComplaintVerdict(complaint.ModerationVerdict)</td>
                                            <td class="text-break">@complaint.Subject</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </section>

            <section class="card border-0 shadow-sm mb-3">
                <div class="card-body">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                        <h2 class="h6 text-uppercase text-muted mb-0">Сводка по отзывам</h2>
                        <span class="small text-muted">Показано: @Model.FeedbackSummary?.RecentItems.Count из @Model.FeedbackTotalCount</span>
                    </div>
                    @if (Model.FeedbackSummary is null)
                    {
                        <div class="alert alert-light border mb-0">Данные по отзывам пока отсутствуют.</div>
                    }
                    else
                    {
                        <div class="row g-2 mb-3">
                            <div class="col-md-3"><div class="small text-muted">Всего отзывов</div><div class="fw-semibold">@Model.FeedbackSummary.TotalFeedbackCount</div></div>
                            <div class="col-md-3"><div class="small text-muted">Покупка</div><div class="fw-semibold">@Model.FeedbackSummary.PurchaseFeedbackCount</div></div>
                            <div class="col-md-3"><div class="small text-muted">Продажа</div><div class="fw-semibold">@Model.FeedbackSummary.SaleFeedbackCount</div></div>
                            <div class="col-md-3"><div class="small text-muted">Средний сервис</div><div class="fw-semibold">@(Model.FeedbackSummary.AverageServiceScore?.ToString("F2") ?? "-")</div></div>
                        </div>
                        <div class="small text-muted mb-2">
                            Коммуникация: @(Model.FeedbackSummary.AverageCommunicationScore?.ToString("F2") ?? "-"),
                            скорость реакции: @(Model.FeedbackSummary.AverageResponsivenessScore?.ToString("F2") ?? "-"),
                            экспертность: @(Model.FeedbackSummary.AverageExpertiseScore?.ToString("F2") ?? "-")
                        </div>
                        <div class="small text-muted mb-3">
                            Точность карточки (покупка): заголовок @(Model.FeedbackSummary.AverageTitleAccuracyScore?.ToString("F2") ?? "-"),
                            описание @(Model.FeedbackSummary.AverageDescriptionAccuracyScore?.ToString("F2") ?? "-"),
                            фото @(Model.FeedbackSummary.AveragePhotosAccuracyScore?.ToString("F2") ?? "-"),
                            критерии @(Model.FeedbackSummary.AverageCriteriaAccuracyScore?.ToString("F2") ?? "-")
                        </div>
                        @if (Model.FeedbackSummary.RecentItems.Count == 0)
                        {
                            <div class="alert alert-light border mb-0">Последние отзывы отсутствуют.</div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-sm align-middle mb-0">
                                    <thead>
                                        <tr>
                                            <th>Дата</th>
                                            <th>Тип</th>
                                            <th>Сервис</th>
                                            <th>Карточка</th>
                                            <th>Комментарий</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model.FeedbackSummary.RecentItems)
                                        {
                                            <tr>
                                                <td class="text-nowrap">@item.CreatedDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                                                <td>@(item.FormType == "Sale" ? "Продажа" : "Покупка")</td>
                                                <td>@item.ServiceScore / 5</td>
                                                <td>
                                                    @if (item.FormType == "Purchase")
                                                    {
                                                        <span>Заг: @item.TitleAccuracyScore, Опис: @item.DescriptionAccuracyScore, Фото: @item.PhotosAccuracyScore, Критерии: @item.CriteriaAccuracyScore</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">не применимо</span>
                                                    }
                                                </td>
                                                <td class="text-break">@(string.IsNullOrWhiteSpace(item.Comment) ? "-" : item.Comment)</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            @if (Model.FeedbackTotalPages > 1)
                            {
                                <nav class="mt-3" aria-label="Пагинация отзывов">
                                    <ul class="pagination pagination-sm mb-0 justify-content-end">
                                        @for (var p = 1; p <= Model.FeedbackTotalPages; p++)
                                        {
                                            <li class="page-item @(p == Model.FeedbackPage ? "active" : null)">
                                                <a class="page-link"
                                                   asp-action="RealtorAnalytics"
                                                   asp-route-realtorId="@Model.SelectedRealtorId"
                                                   asp-route-search="@Model.Search"
                                                   asp-route-level="@Model.Level"
                                                   asp-route-realtorPage="@Model.RealtorsPage"
                                                   asp-route-feedbackPage="@p"
                                                   asp-route-scorePage="@Model.ScoreHistoryPage">@p</a>
                                            </li>
                                        }
                                    </ul>
                                </nav>
                            }
                        }
                    }
                </div>
            </section>

            <section class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                        <h2 class="h6 text-uppercase text-muted mb-0">История оценок</h2>
                        <span class="small text-muted">Показано: @Model.ScoreHistory.Count из @Model.ScoreHistoryTotalCount</span>
                    </div>
                    @if (Model.ScoreHistory.Count == 0)
                    {
                        <div class="alert alert-light border mb-0">История пока отсутствует.</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Дата</th>
                                        <th>CTS</th>
                                        <th>APS</th>
                                        <th>Версия</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in Model.ScoreHistory)
                                    {
                                        <tr>
                                            <td>@row.CreatedDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                                            <td>@row.ClientTrustScore.ToString("F2")</td>
                                            <td>@row.AdminPerformanceScore.ToString("F2")</td>
                                            <td>@(string.IsNullOrWhiteSpace(row.CalculationVersion) ? "-" : row.CalculationVersion)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        @if (Model.ScoreHistoryTotalPages > 1)
                        {
                            <nav class="mt-3" aria-label="Пагинация истории оценок">
                                <ul class="pagination pagination-sm mb-0 justify-content-end">
                                    @for (var p = 1; p <= Model.ScoreHistoryTotalPages; p++)
                                    {
                                        <li class="page-item @(p == Model.ScoreHistoryPage ? "active" : null)">
                                            <a class="page-link"
                                               asp-action="RealtorAnalytics"
                                               asp-route-realtorId="@Model.SelectedRealtorId"
                                               asp-route-search="@Model.Search"
                                               asp-route-level="@Model.Level"
                                               asp-route-realtorPage="@Model.RealtorsPage"
                                               asp-route-feedbackPage="@Model.FeedbackPage"
                                               asp-route-scorePage="@p">@p</a>
                                        </li>
                                    }
                                </ul>
                            </nav>
                        }
                    }
                </div>
            </section>
        }
    </div>
</div>

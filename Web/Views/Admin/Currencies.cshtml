@model Web.Models.Dashboard.AdminCurrenciesViewModel
@{
    ViewData["Title"] = "Валюты и курсы";
    var activeMenu = (string?)ViewData["AdminActive"] ?? string.Empty;
}

<div class="row g-3">
    <div class="col-xl-3 col-lg-4">
        <partial name="_Sidebar" model="activeMenu" />
    </div>
    <div class="col-xl-9 col-lg-8">
        <section class="card border-0 shadow-sm mb-3">
            <div class="card-body">
                <h1 class="h4 mb-1">Валюты и курсы</h1>
                <div class="text-muted mb-3">Настройка валют, которые используются в карточках недвижимости и расчётах.</div>

                <form method="get" asp-action="Currencies" class="form-check form-switch mb-3">
                    <input class="form-check-input" type="checkbox" role="switch" id="includeInactive" name="includeInactive" value="true" checked="@(Model.IncludeInactive ? "checked" : null)" onchange="this.form.submit()" />
                    <label class="form-check-label" for="includeInactive">Показывать неактивные валюты</label>
                </form>

                <h2 class="h5 mb-3">Добавить валюту</h2>
                <form asp-action="CreateCurrency" method="post" class="row g-2">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="includeInactive" value="@(Model.IncludeInactive ? "true" : "false")" />
                    <div class="col-md-2">
                        <label class="form-label">Код</label>
                        <input type="text" name="code" class="form-control text-uppercase" maxlength="3" required />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Название</label>
                        <input type="text" name="name" class="form-control" maxlength="100" required />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Символ</label>
                        <input type="text" name="symbol" class="form-control" maxlength="10" required />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Курс к базовой валюте USD</label>
                        <input type="number" name="rateToBase" class="form-control" min="0.000001" step="0.000001" required />
                        <div class="form-text">Например: 1 EUR = 1.08 USD.</div>
                    </div>
                    <div class="col-md-2 form-check mt-4 ms-md-2">
                        <input class="form-check-input" type="checkbox" name="isActive" value="true" checked="checked" id="createCurrencyActive" />
                        <label class="form-check-label" for="createCurrencyActive">Активна</label>
                    </div>
                    <div class="col-12">
                        <button type="submit" class="btn btn-primary">Создать</button>
                    </div>
                </form>
            </div>
        </section>

        @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
        {
            <div class="alert alert-success">@Model.SuccessMessage</div>
        }

        @if (Model.ApiError is not null)
        {
            <partial name="_ApiErrorAlert" model="Model.ApiError" />
        }

        <section class="card border-0 shadow-sm">
            <div class="card-body">
                <h2 class="h5 mb-3">Список валют</h2>

                @if (Model.Currencies.Count == 0)
                {
                    <div class="alert alert-light border mb-0">Валюты не найдены.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle admin-comfort-table mb-0">
                            <thead>
                                <tr>
                                    <th>Код</th>
                                    <th>Название</th>
                                    <th>Символ</th>
                                    <th>Курс</th>
                                    <th>Статус</th>
                                    <th>Обновлено</th>
                                    <th>Действия</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Currencies)
                                {
                                    var rateText = item.RateToBase.ToString("0.######", System.Globalization.CultureInfo.InvariantCulture);
                                    <tr>
                                        <td><strong>@item.Code</strong></td>
                                        <td>@item.Name</td>
                                        <td>@item.Symbol</td>
                                        <td>
                                            <div class="fw-semibold">@rateText</div>
                                            <div class="small text-muted">1 @item.Code = @rateText USD</div>
                                        </td>
                                        <td>
                                            <span class="badge @(item.IsActive ? "text-bg-success" : "text-bg-secondary")">
                                                @(item.IsActive ? "Активна" : "Отключена")
                                            </span>
                                        </td>
                                        <td class="text-nowrap">@item.UpdatedAtUtc.ToString("dd.MM.yyyy HH:mm")</td>
                                        <td>
                                            <details>
                                                <summary class="text-primary">Изменить</summary>
                                                <form asp-action="UpdateCurrency" method="post" class="row g-2 mt-2">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="currencyId" value="@item.Id" />
                                                    <input type="hidden" name="includeInactive" value="@(Model.IncludeInactive ? "true" : "false")" />
                                                    <div class="col-md-2"><input type="text" name="code" value="@item.Code" class="form-control form-control-sm text-uppercase" maxlength="3" required /></div>
                                                    <div class="col-md-3"><input type="text" name="name" value="@item.Name" class="form-control form-control-sm" maxlength="100" required /></div>
                                                    <div class="col-md-2"><input type="text" name="symbol" value="@item.Symbol" class="form-control form-control-sm" maxlength="10" required /></div>
                                                    <div class="col-md-3"><input type="number" name="rateToBase" value="@rateText" class="form-control form-control-sm" min="0.000001" step="0.000001" required /></div>
                                                    <div class="col-md-2 form-check mt-2">
                                                        <input class="form-check-input" type="checkbox" name="isActive" value="true" checked="@(item.IsActive ? "checked" : null)" id="active_@item.Id" />
                                                        <label class="form-check-label" for="active_@item.Id">Активна</label>
                                                    </div>
                                                    <div class="col-12 d-flex gap-2">
                                                        <button type="submit" class="btn btn-outline-primary btn-sm">Сохранить</button>
                                                    </div>
                                                </form>

                                                <div class="d-flex gap-2 mt-2">
                                                    <form asp-action="SetCurrencyActive" method="post">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="currencyId" value="@item.Id" />
                                                        <input type="hidden" name="isActive" value="@(!item.IsActive ? "true" : "false")" />
                                                        <input type="hidden" name="includeInactive" value="@(Model.IncludeInactive ? "true" : "false")" />
                                                        <button type="submit" class="btn btn-outline-secondary btn-sm">@(item.IsActive ? "Отключить" : "Активировать")</button>
                                                    </form>

                                                    <form asp-action="DeleteCurrency" method="post" onsubmit="return confirm('Удалить валюту?');">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="currencyId" value="@item.Id" />
                                                        <input type="hidden" name="includeInactive" value="@(Model.IncludeInactive ? "true" : "false")" />
                                                        <button type="submit" class="btn btn-outline-danger btn-sm">Удалить</button>
                                                    </form>
                                                </div>
                                            </details>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </section>
    </div>
</div>

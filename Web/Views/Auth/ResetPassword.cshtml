@model Web.Models.Auth.ResetPasswordRequest
@{
    ViewData["Title"] = "Смена пароля";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-9 col-lg-7">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4 p-md-5">
                <h1 class="h3 mb-3">Смена пароля</h1>
                <p class="text-muted mb-4">
                    Введите код из письма и новый пароль. Если запросить новый код, предыдущий перестанет работать.
                </p>

                @if (ViewData["ApiError"] is Web.Models.Api.ApiErrorViewModel apiError)
                {
                    <partial name="_ApiErrorAlert" model="apiError" />
                }

                @if (ViewData["AuthSuccess"] is string successMessage && !string.IsNullOrWhiteSpace(successMessage))
                {
                    <div class="alert alert-success">@successMessage</div>
                }

                @if (!ViewData.ModelState.IsValid)
                {
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                }

                <form asp-action="ResetPassword" method="post" class="vstack gap-3">
                    @Html.AntiForgeryToken()

                    <div>
                        <label asp-for="Email" class="form-label">Email</label>
                        <input asp-for="Email" class="form-control" autocomplete="email" placeholder="name@example.com" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div>
                        <label asp-for="Code" class="form-label">Код восстановления</label>
                        <input asp-for="Code"
                               class="form-control text-center fs-4"
                               inputmode="numeric"
                               autocomplete="one-time-code"
                               maxlength="6"
                               placeholder="000000" />
                        <span asp-validation-for="Code" class="text-danger"></span>
                    </div>

                    <div>
                        <label asp-for="NewPassword" class="form-label">Новый пароль</label>
                        <div class="input-group password-input-group">
                            <input asp-for="NewPassword" type="password" class="form-control" autocomplete="new-password" />
                            <button class="btn btn-outline-secondary password-toggle" type="button" aria-label="Показать пароль" title="Показать пароль">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="NewPassword" class="text-danger"></span>
                    </div>

                    <div>
                        <label asp-for="ConfirmPassword" class="form-label">Подтверждение пароля</label>
                        <div class="input-group password-input-group">
                            <input asp-for="ConfirmPassword" type="password" class="form-control" autocomplete="new-password" />
                            <button class="btn btn-outline-secondary password-toggle" type="button" aria-label="Показать пароль" title="Показать пароль">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>

                    <div class="row g-2">
                        <div class="col-12 col-sm-4 d-grid">
                            <button type="submit" class="btn btn-primary">Сохранить пароль</button>
                        </div>
                        <div class="col-12 col-sm-4 d-grid">
                            <a asp-action="ForgotPassword" class="btn btn-outline-secondary">Получить новый код</a>
                        </div>
                        <div class="col-12 col-sm-4 d-grid">
                            <a asp-action="Login" class="btn btn-outline-secondary">Отмена</a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

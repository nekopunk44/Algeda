@model Web.Models.Auth.ForgotPasswordRequest
@{
    ViewData["Title"] = "Восстановление пароля";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-8 col-lg-6">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4 p-md-5">
                <h1 class="h3 mb-3">Восстановление пароля</h1>
                <p class="text-muted mb-4">
                    Укажите email аккаунта. Мы отправим шестизначный код для смены пароля.
                </p>

                @if (ViewData["ApiError"] is Web.Models.Api.ApiErrorViewModel apiError)
                {
                    <partial name="_ApiErrorAlert" model="apiError" />
                }

                @if (!ViewData.ModelState.IsValid)
                {
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                }

                <form asp-action="ForgotPassword" method="post" class="vstack gap-3">
                    @Html.AntiForgeryToken()

                    <div>
                        <label asp-for="Email" class="form-label">Email</label>
                        <input asp-for="Email" class="form-control" autocomplete="email" placeholder="name@example.com" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="row g-2">
                        <div class="col-12 col-sm-4 d-grid">
                            <button type="submit" class="btn btn-primary">Отправить код</button>
                        </div>
                        <div class="col-12 col-sm-4 d-grid">
                            <a asp-action="ResetPassword" asp-route-email="@Model.Email" class="btn btn-outline-secondary">У меня есть код</a>
                        </div>
                        <div class="col-12 col-sm-4 d-grid">
                            <a asp-action="Login" class="btn btn-outline-secondary">Ко входу</a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@{
    ViewData["Title"] = "Заявка отправлена";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-8 col-lg-6">
        <div class="card border-0 shadow-sm text-center">
            <div class="card-body p-4 p-md-5">
                <div class="mb-3">
                    <i class="bi bi-check2-circle text-success" style="font-size: 2.5rem;"></i>
                </div>
                <h1 class="h3 mb-3">Заявка отправлена</h1>
                <p class="text-muted mb-4">
                    Email подтвержден. Заявка на регистрацию риелтора отправлена администратору.
                    После проверки можно будет войти в систему.
                </p>
                <div class="d-flex justify-content-center gap-2">
                    <a asp-action="Login" class="btn btn-primary">Перейти ко входу</a>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">На главную</a>
                </div>
            </div>
        </div>
    </div>
</div>

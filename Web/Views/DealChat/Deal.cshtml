@model Web.Models.DealChat.DealChatPageViewModel
@{
    ViewData["Title"] = "Чат по сделке";
    var dialog = Model.Dialog;
    var isAdminViewer = User.IsInRole("Admin") || User.IsInRole("SuperAdmin");
    var backUrl = string.IsNullOrWhiteSpace(Model.ReturnUrl)
        ? Url.Action("Details", "DealCenter", new { id = Model.DealId })
        : Model.ReturnUrl;
}

<section class="mb-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
        <h1 class="h3 mb-0">Чат по сделке</h1>
        @if (!string.IsNullOrWhiteSpace(backUrl))
        {
            <a href="@backUrl" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i>Назад
            </a>
        }
    </div>
</section>

@if (Model.ApiError is not null)
{
    <partial name="_ApiErrorAlert" model="Model.ApiError" />
}

@if (dialog is null)
{
    <div class="alert alert-light border">Чат недоступен.</div>
}
else
{
    <section class="card border-0 shadow-sm mb-3">
        <div class="card-body p-4">
            <div class="row g-2 mb-3">
                <div class="col-md-6">
                    <div class="small text-muted">Сделка</div>
                    <div class="text-break">@dialog.DealId</div>
                </div>
                <div class="col-md-6">
                    <div class="small text-muted">Клиент / Риелтор</div>
                    <div>@(dialog.ClientName ?? "Клиент") / @(dialog.RealtorName ?? "Риелтор")</div>
                </div>
            </div>

            @if (!dialog.CanWrite && !string.IsNullOrWhiteSpace(dialog.BlockReason))
            {
                <div class="alert alert-light border">@dialog.BlockReason</div>
            }

            <div id="dealChatMessages"
                 class="border rounded p-3"
                 style="min-height: 280px; max-height: 520px; overflow-y: auto; background-color: #fbfcfe;">
                @if (dialog.Messages.Count == 0)
                {
                    <div id="dealChatEmptyState" class="text-muted">Пока нет сообщений.</div>
                }
                else
                {
                    @foreach (var message in dialog.Messages)
                    {
                        var isClientMessage = message.SenderId == dialog.ClientId;
                        var alignRight = isAdminViewer ? !isClientMessage : message.IsOutgoing;
                        var authorLabel = isClientMessage ? "Клиент" : "Риелтор";
                        <div class="d-flex @(alignRight ? "justify-content-end" : "justify-content-start") mb-2">
                            <div class="p-2 rounded @(alignRight ? "bg-primary text-white" : "bg-white border")" style="max-width: 75%;">
                                @if (isAdminViewer)
                                {
                                    <div class="small fw-semibold @(alignRight ? "text-white-50" : "text-muted") mb-1">@authorLabel</div>
                                }
                                <div>@message.Content</div>
                                <div class="small @(alignRight ? "text-white-50" : "text-muted") mt-1">
                                    @message.CreatedDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>

            @if (dialog.CanWrite)
            {
                <form id="dealChatSendForm" asp-action="Send" asp-route-dealId="@dialog.DealId" method="post" class="mt-3">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                    <div id="dealChatSendError" class="alert alert-danger py-2 px-3 mb-2 d-none" role="alert"></div>
                    <div class="input-group">
                        <textarea id="dealChatContentInput" name="content" class="form-control" rows="2" maxlength="4000" placeholder="Введите сообщение" required></textarea>
                        <button type="submit" class="btn btn-primary">Отправить</button>
                    </div>
                </form>
            }
        </div>
    </section>
}

@section Scripts {
    @if (dialog is not null)
    {
        <script>
            (function () {
                const messagesContainer = document.getElementById("dealChatMessages");
                if (!messagesContainer) {
                    return;
                }

                const dealId = "@dialog.DealId";
                const clientId = "@dialog.ClientId";
                const isAdminViewer = @isAdminViewer.ToString().ToLowerInvariant();
                let lastMessageId = "@(dialog.Messages.LastOrDefault()?.Id.ToString() ?? string.Empty)";
                const pollIntervalMs = 3000;
                const sendForm = document.getElementById("dealChatSendForm");
                const contentInput = document.getElementById("dealChatContentInput");
                const sendError = document.getElementById("dealChatSendError");

                function escapeHtml(value) {
                    return String(value ?? "")
                        .replaceAll("&", "&amp;")
                        .replaceAll("<", "&lt;")
                        .replaceAll(">", "&gt;")
                        .replaceAll("\"", "&quot;")
                        .replaceAll("'", "&#39;");
                }

                function formatDate(dateRaw) {
                    const date = new Date(dateRaw);
                    if (Number.isNaN(date.getTime())) {
                        return "";
                    }

                    return date.toLocaleString("ru-RU", {
                        day: "2-digit",
                        month: "2-digit",
                        year: "numeric",
                        hour: "2-digit",
                        minute: "2-digit"
                    });
                }

                function isNearBottom() {
                    const delta = messagesContainer.scrollHeight - messagesContainer.scrollTop - messagesContainer.clientHeight;
                    return delta < 48;
                }

                function renderMessages(messages) {
                    if (!Array.isArray(messages) || messages.length === 0) {
                        messagesContainer.innerHTML = '<div id="dealChatEmptyState" class="text-muted">Пока нет сообщений.</div>';
                        lastMessageId = "";
                        return;
                    }

                    messagesContainer.innerHTML = messages.map((message) => {
                        const isClientMessage = String(message.senderId ?? "").toLowerCase() === clientId.toLowerCase();
                        const alignRight = isAdminViewer ? !isClientMessage : !!message.isOutgoing;
                        const alignClass = alignRight ? "justify-content-end" : "justify-content-start";
                        const bubbleClass = alignRight ? "bg-primary text-white" : "bg-white border";
                        const dateClass = alignRight ? "text-white-50" : "text-muted";
                        const author = isClientMessage ? "Клиент" : "Риелтор";
                        const authorHtml = isAdminViewer
                            ? `<div class="small fw-semibold ${dateClass} mb-1">${author}</div>`
                            : "";

                        return `<div class="d-flex ${alignClass} mb-2">
                            <div class="p-2 rounded ${bubbleClass}" style="max-width: 75%;">
                                ${authorHtml}
                                <div>${escapeHtml(message.content)}</div>
                                <div class="small ${dateClass} mt-1">${formatDate(message.createdDate)}</div>
                            </div>
                        </div>`;
                    }).join("");

                    const newest = messages[messages.length - 1];
                    lastMessageId = newest?.id ?? "";
                }

                async function poll() {
                    try {
                        const shouldScroll = isNearBottom();
                        const response = await fetch(`/deal-chat/deals/${dealId}/dialog?limit=200`, {
                            credentials: "same-origin",
                            headers: { "X-Requested-With": "XMLHttpRequest" }
                        });

                        if (!response.ok) {
                            return;
                        }

                        const payload = await response.json();
                        const messages = Array.isArray(payload?.messages) ? payload.messages : [];
                        const newestId = messages.length > 0 ? messages[messages.length - 1].id : "";
                        const hasChanges = newestId !== lastMessageId || messages.length === 0 && lastMessageId !== "";

                        if (!hasChanges) {
                            return;
                        }

                        renderMessages(messages);
                        if (shouldScroll) {
                            messagesContainer.scrollTop = messagesContainer.scrollHeight;
                        }
                    } catch {
                        // ignore transient polling errors
                    }
                }

                async function sendMessage(formData) {
                    const response = await fetch(sendForm.action, {
                        method: "POST",
                        body: formData,
                        credentials: "same-origin",
                        headers: { "X-Requested-With": "XMLHttpRequest" }
                    });

                    const payload = await response.json().catch(() => null);
                    if (!response.ok || !payload?.success) {
                        throw new Error(payload?.message || "Не удалось отправить сообщение.");
                    }
                }

                if (sendForm && contentInput) {
                    sendForm.addEventListener("submit", async function (event) {
                        event.preventDefault();

                        const text = contentInput.value.trim();
                        if (!text) {
                            return;
                        }

                        if (sendError) {
                            sendError.classList.add("d-none");
                            sendError.textContent = "";
                        }

                        const shouldScroll = true;
                        const formData = new FormData(sendForm);
                        formData.set("content", text);

                        try {
                            await sendMessage(formData);
                            contentInput.value = "";
                            await poll();
                            if (shouldScroll) {
                                messagesContainer.scrollTop = messagesContainer.scrollHeight;
                            }
                        } catch (error) {
                            if (sendError) {
                                sendError.textContent = error instanceof Error ? error.message : "Не удалось отправить сообщение.";
                                sendError.classList.remove("d-none");
                            }
                        }
                    });
                }

                messagesContainer.scrollTop = messagesContainer.scrollHeight;
                setInterval(poll, pollIntervalMs);
            })();
        </script>
    }
}

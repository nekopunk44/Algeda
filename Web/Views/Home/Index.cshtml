@model Web.Models.Properties.HomeMapViewModel
@using System.Text.Json
@using Web.Models.Properties
@inject Web.Services.ICurrencyFormatter CurrencyFormatter
@{
    ViewData["Title"] = "Главная";
    var homeCatalogUrl = $"{Url.Action("Index", "Home")}#catalog";

    var jsonOptions = new JsonSerializerOptions(JsonSerializerDefaults.Web);
    var initJson = JsonSerializer.Serialize(new
    {
        properties = Model.Properties,
        currencies = Model.Currencies.Select(x => new
        {
            code = x.Code,
            name = x.Name,
            rateToBase = x.RateToBase
        }),
        pricing = CurrencyFormatter.GetClientSettings(),
        detailsUrlTemplate = Url.Action("Details", "Properties", new { id = "__id__", returnUrl = homeCatalogUrl }),
        typeLabels = Model.Properties
            .Select(x => x.Type)
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToDictionary(x => x, PropertyValueDisplay.Type, StringComparer.OrdinalIgnoreCase)
    }, jsonOptions);
}

<section class="mb-4">
    <div id="homeBannerCarousel" class="carousel slide home-banner-carousel rounded-4 overflow-hidden shadow-sm" data-bs-ride="carousel" data-bs-interval="5200" data-bs-touch="true">
        <div class="carousel-indicators">
            <button type="button" data-bs-target="#homeBannerCarousel" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Слайд 1"></button>
            <button type="button" data-bs-target="#homeBannerCarousel" data-bs-slide-to="1" aria-label="Слайд 2"></button>
            <button type="button" data-bs-target="#homeBannerCarousel" data-bs-slide-to="2" aria-label="Слайд 3"></button>
        </div>
        <div class="carousel-inner">
            <div class="carousel-item active">
                <img src="~/images/home-banners/banner1.jpeg" class="d-block w-100 home-banner-image" alt="Баннер 1" />
                <div class="home-banner-caption">
                    <div class="home-banner-kicker">Подбор недвижимости</div>
                    <div class="home-banner-title">Подберите недвижимость по вашим требованиям.</div>
                </div>
            </div>
            <div class="carousel-item">
                <img src="~/images/home-banners/banner2.jpg" class="d-block w-100 home-banner-image" alt="Баннер 2" />
                <div class="home-banner-caption">
                    <div class="home-banner-kicker">Заявка онлайн</div>
                    <div class="home-banner-title">Оставьте заявку на покупку или продажу объекта.</div>
                </div>
            </div>
            <div class="carousel-item">
                <img src="~/images/home-banners/banner3.jpg" class="d-block w-100 home-banner-image" alt="Баннер 3" />
                <div class="home-banner-caption">
                    <div class="home-banner-kicker">Сделка онлайн</div>
                    <div class="home-banner-title">Следите за сделкой и общайтесь с риелтором онлайн.</div>
                </div>
            </div>
        </div>
        <button class="carousel-control-prev" type="button" data-bs-target="#homeBannerCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Назад</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#homeBannerCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Вперед</span>
        </button>
    </div>
</section>

<section class="mb-4">
    <div class="rounded-4 p-4 p-lg-5 home-hero">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <h1 class="display-6 fw-bold mb-2">Карта и каталог недвижимости</h1>
                <p class="lead mb-0 text-secondary">Просматривайте объекты и используйте базовую фильтрацию прямо на главной странице.</p>
            </div>

            @if (Model.IsAuthenticated)
            {
                <a asp-controller="Matching" asp-action="Index" class="btn btn-primary btn-lg">
                    <i class="bi bi-stars me-1"></i> Подбор недвижимости
                </a>
            }
            else
            {
                <button type="button" class="btn btn-primary btn-lg" data-bs-toggle="modal" data-bs-target="#smartMatchingAuthModal">
                    <i class="bi bi-stars me-1"></i> Подбор недвижимости
                </button>
            }
        </div>
    </div>
</section>

<section class="card border-0 shadow-sm" id="catalog">
    <div class="card-body p-4 p-lg-5">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <h2 class="h3 mb-0">Объекты на карте</h2>
            <span class="badge rounded-pill text-bg-light border px-3 py-2" id="resultsCountBadge">0</span>
        </div>

        @if (Model.ApiError is not null)
        {
            <partial name="_ApiErrorAlert" model="Model.ApiError" />
        }

        <div class="row g-3">
            <div class="col-lg-4">
                <div class="card h-100 border">
                    <div class="card-body">
                        <h3 class="h6 text-uppercase text-muted mb-3">Фильтры</h3>

                        <div class="mb-3">
                            <label for="filterSearch" class="form-label">Поиск</label>
                            <input id="filterSearch" type="text" class="form-control" placeholder="Адрес или название" />
                        </div>

                        <div class="mb-3">
                            <label for="filterType" class="form-label">Тип</label>
                            <select id="filterType" class="form-select">
                                <option value="">Любой</option>
                                <option value="Apartment">Квартира</option>
                                <option value="House">Дом</option>
                                <option value="Commercial">Коммерческая</option>
                                <option value="Land">Участок</option>
                            </select>
                        </div>

                        <div class="row g-2 mb-3">
                            <div class="col-4">
                                <label for="filterMinPrice" class="form-label">Цена от</label>
                                <input id="filterMinPrice" type="number" min="0" class="form-control" placeholder="0" />
                            </div>
                            <div class="col-4">
                                <label for="filterMaxPrice" class="form-label">Цена до</label>
                                <input id="filterMaxPrice" type="number" min="0" class="form-control" placeholder="500000" />
                            </div>
                            <div class="col-4">
                                <label for="filterPriceCurrency" class="form-label">Валюта</label>
                                <select id="filterPriceCurrency" class="form-select">
                                    @foreach (var currency in Model.Currencies)
                                    {
                                        <option value="@currency.Code" selected="@(string.Equals(currency.Code, CurrencyFormatter.GetClientSettings().BaseCurrencyCode, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">
                                            @currency.Code
                                        </option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <label for="filterMinRooms" class="form-label">Комнат от</label>
                                <input id="filterMinRooms" type="number" min="0" class="form-control" placeholder="1" />
                            </div>
                            <div class="col-6">
                                <label for="filterMaxRooms" class="form-label">Комнат до</label>
                                <input id="filterMaxRooms" type="number" min="0" class="form-control" placeholder="8" />
                            </div>
                        </div>

                        <div class="d-grid gap-2">
                            <button id="applyFilters" type="button" class="btn btn-primary btn-sm w-100">
                                Применить
                            </button>
                            <button id="resetFilters" type="button" class="btn btn-outline-secondary btn-sm w-100">
                                Сбросить
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-8">
                <div class="position-relative">
                    <div id="mapLoader" class="map-loader">
                        <div class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></div>
                        Загрузка карты...
                    </div>
                    <div id="homePropertiesMap" class="properties-map rounded-4 border"></div>
                </div>
            </div>
        </div>

        <div id="propertiesEmpty" class="alert alert-light border mt-3 d-none">
            По текущим фильтрам ничего не найдено.
        </div>

        <div id="resultsRenderHint" class="small text-muted mt-2"></div>

        <div class="row g-3 mt-1" id="propertiesList"></div>
        <nav id="propertiesPaginationNav" class="mt-3 d-none" aria-label="Пагинация списка объектов">
            <ul id="propertiesPagination" class="pagination pagination-sm justify-content-center mb-0"></ul>
        </nav>
    </div>
</section>

@if (!Model.IsAuthenticated)
{
    <div class="modal fade" id="smartMatchingAuthModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Подбор недвижимости</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
                </div>
                <div class="modal-body">
                    На сайте доступен расширенный модуль подбора недвижимости. Чтобы использовать его, необходимо зарегистрироваться.
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Назад</button>
                    <a asp-controller="Auth" asp-action="Register" class="btn btn-primary">Перейти к регистрации</a>
                </div>
            </div>
        </div>
    </div>
}

@section Styles {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
}

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="~/js/home-page.js" asp-append-version="true"></script>
    <script>
        window.homePageInit(@Html.Raw(initJson));
    </script>
}

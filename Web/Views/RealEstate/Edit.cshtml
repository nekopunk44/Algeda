@model Web.Models.RealEstate.RealEstateEditViewModel
@using System.Text.Json
@using Web.Models.Properties
@inject Web.Services.ICurrencyFormatter CurrencyFormatter
@{
    ViewData["Title"] = "Редактирование объекта";
    var baseCurrencyCode = CurrencyFormatter.GetClientSettings().BaseCurrencyCode;

    var criteriaInitJson = JsonSerializer.Serialize(new
    {
        definitions = Model.CriterionDefinitions.Select(d => new
        {
            id = d.Id,
            code = d.Code,
            displayName = d.DisplayName,
            category = d.Category,
            description = d.Description,
            valueType = d.ValueType,
            options = d.Options
                .OrderBy(o => o.SortOrder)
                .ThenBy(o => o.Label)
                .Select(o => new
                {
                    value = o.Value,
                    label = o.Label
                })
        }),
        existing = Model.CurrentCriteria.Select(c => new
        {
            criterionDefinitionId = c.CriterionDefinitionId,
            valueType = c.ValueType,
            rawValue = c.RawValue
        })
    });
}

<section class="mb-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
        <h1 class="h2 mb-0">Редактирование объекта</h1>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">К списку</a>
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
{
    <div class="alert alert-success" role="alert">@Model.SuccessMessage</div>
}

@if (Model.ApiError is not null)
{
    <partial name="_ApiErrorAlert" model="Model.ApiError" />
}

@if (Model.Property is null)
{
    <div class="alert alert-warning">Объект не найден или недоступен.</div>
}
else
{
    <section class="card border-0 shadow-sm mb-3">
        <div class="card-body p-4">
            <form asp-action="Update" asp-route-id="@Model.Property.Id" method="post" enctype="multipart/form-data" class="row g-3" id="realEstateEditForm" data-explicit-submit="true">
                @Html.AntiForgeryToken()
                <input type="hidden" id="criteriaJson" name="criteriaJson" />

                <div class="col-lg-7">
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label">Заголовок</label>
                            <input type="text" name="title" class="form-control" value="@Model.Property.Title" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Тип</label>
                            <select name="type" class="form-select" required>
                                <option value="Apartment" selected="@(Model.Property.Type == "Apartment" ? "selected" : null)">Квартира</option>
                                <option value="House" selected="@(Model.Property.Type == "House" ? "selected" : null)">Дом</option>
                                <option value="Commercial" selected="@(Model.Property.Type == "Commercial" ? "selected" : null)">Коммерция</option>
                                <option value="Land" selected="@(Model.Property.Type == "Land" ? "selected" : null)">Участок</option>
                            </select>
                        </div>

                        <div class="col-md-8">
                            <label class="form-label">Адрес</label>
                            <div class="input-group">
                                <input type="text" id="addressInput" name="address" class="form-control" value="@Model.Property.Address" required />
                                <button type="button" id="searchAddressButton" class="btn btn-outline-secondary">Найти на карте</button>
                            </div>
                            <div class="form-text" id="mapStatusText">Можно выбрать новую точку прямо на карте.</div>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Широта</label>
                            <input type="number" id="latitudeInput" name="latitude" step="0.000001" class="form-control" value="@Model.Property.Latitude.ToString("0.######", System.Globalization.CultureInfo.InvariantCulture)" required />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Долгота</label>
                            <input type="number" id="longitudeInput" name="longitude" step="0.000001" class="form-control" value="@Model.Property.Longitude.ToString("0.######", System.Globalization.CultureInfo.InvariantCulture)" required />
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">Цена (исходная)</label>
                            <input type="number" name="price" min="1" step="1" class="form-control" value="@Model.Property.OriginalPriceAmount.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" required />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Валюта</label>
                            <select name="priceCurrency" class="form-select" required>
                                @if (Model.Currencies.Count == 0)
                                {
                                    <option value="@Model.Property.OriginalPriceCurrency" selected>@Model.Property.OriginalPriceCurrency</option>
                                }
                                else
                                {
                                    foreach (var currency in Model.Currencies.Where(x => x.IsActive).OrderBy(x => x.Code))
                                    {
                                        <option value="@currency.Code" selected="@(currency.Code == Model.Property.OriginalPriceCurrency ? "selected" : null)">
                                            @currency.Code (@currency.Symbol)
                                        </option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Площадь, м²</label>
                            <input type="number" name="area" min="1" step="0.1" class="form-control" value="@Model.Property.Area.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Комнат</label>
                            <input type="number" name="roomsCount" min="1" class="form-control" value="@Model.Property.RoomsCount" required />
                        </div>

                        <div class="col-12 mt-4">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="unregisteredOwnerToggle" @(Model.Property.OwnerClientId == null ? "checked" : "")>
                                <label class="form-check-label" for="unregisteredOwnerToggle">Собственник не зарегистрирован (ввести вручную)</label>
                            </div>
                        </div>

                        <!-- Client Selection -->
                        <div class="col-12" id="registeredOwnerContainer">
                            <label class="form-label">Собственник (Клиент)</label>
                            <div class="input-group">
                                <input type="hidden" name="ownerClientId" id="ownerClientIdInput" value="@Model.Property.OwnerClientId" />
                                <input type="text" id="ownerClientNameDisplay" class="form-control" value="@(Model.Property.OwnerClientId != null ? string.Join(" | ", new[] { Model.Property.OwnerFullName, Model.Property.OwnerEmail, Model.Property.OwnerPhoneNumber }.Where(s => !string.IsNullOrWhiteSpace(s))) : "Не выбран")" readonly />
                                <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#clientSearchModal">Выбрать клиента</button>
                            </div>
                        </div>

                        <!-- Manual Input -->
                        <div class="row g-3 d-none mt-2" id="unregisteredOwnerContainer">
                            <div class="col-md-4">
                                <label class="form-label">ФИО собственника</label>
                                <input type="text" id="manualOwnerFullName" name="ownerFullName" class="form-control" value="@Model.Property.OwnerFullName" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Email собственника</label>
                                <input type="email" id="manualOwnerEmail" name="ownerEmail" class="form-control" value="@Model.Property.OwnerEmail" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Телефон собственника</label>
                                <input type="text" id="manualOwnerPhoneNumber" name="ownerPhoneNumber" class="form-control" value="@Model.Property.OwnerPhoneNumber" />
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="small text-muted mb-1">Текущий статус: <strong>@PropertyValueDisplay.Status(Model.Property.Status)</strong></div>
                            <div class="small text-muted">Исходная цена: <strong>@CurrencyFormatter.Format(Model.Property.OriginalPriceAmount, Model.Property.OriginalPriceCurrency)</strong></div>
                            @if (!string.Equals(Model.Property.OriginalPriceCurrency, baseCurrencyCode, StringComparison.OrdinalIgnoreCase))
                            {
                                <div class="small text-muted">≈ <strong>@CurrencyFormatter.Format(Model.Property.Price)</strong></div>
                            }
                            @if (Model.Property.SoldAtUtc.HasValue)
                            {
                                <div class="small text-muted">Дата продажи (UTC): <strong>@Model.Property.SoldAtUtc.Value.ToString("dd.MM.yyyy HH:mm")</strong></div>
                            }
                        </div>
                    </div>
                </div>

                <div class="col-lg-5">
                    <label class="form-label">Позиция на карте</label>
                    <div id="propertyMap" class="rounded border" style="min-height: 300px;"></div>
                </div>

                <div class="col-12">
                    <h2 class="h6 text-uppercase text-muted mb-2">Фотографии</h2>
                    <div id="retainPhotoInputs"></div>
                    @if (Model.Property.PhotoPaths.Count == 0)
                    {
                        <div class="alert alert-light border">Фотографии пока не добавлены.</div>
                    }
                    else
                    {
                        <div class="small text-muted mb-2">
                            Порядок фотографий сохраняется. Удаление будет применено только после нажатия «Сохранить изменения».<br />
                            Оставить после сохранения: <span id="retainedPhotosCount">@Model.Property.PhotoPaths.Count</span>
                        </div>
                        <div class="row g-2 mb-2" id="existingPhotosList">
                            @for (var i = 0; i < Model.Property.PhotoPaths.Count; i++)
                            {
                                var photoPath = Model.Property.PhotoPaths[i];
                                <div class="col-sm-6 col-lg-4 js-photo-card" data-photo-path="@photoPath">
                                    <div class="border rounded p-2 h-100 d-flex flex-column">
                                        <img src="@photoPath" alt="Фото объекта" class="w-100 rounded mb-2" style="height: 150px; object-fit: cover;" />
                                        <div class="btn-group btn-group-sm mb-2" role="group">
                                            <button type="button" class="btn btn-outline-secondary js-photo-move-up">Вверх</button>
                                            <button type="button" class="btn btn-outline-secondary js-photo-move-down">Вниз</button>
                                            <button type="button" class="btn btn-outline-danger js-photo-delete">Удалить</button>
                                        </div>
                                        <div class="small text-danger d-none js-photo-delete-note">Будет удалено после сохранения</div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    <label class="form-label">Добавить новые фото</label>
                    <input type="file" name="newPhotos" class="form-control" accept=".jpg,.jpeg,.png,.webp" multiple />
                </div>

                <div class="col-12 d-flex flex-wrap gap-2">
                    <button type="submit" class="btn btn-primary">Сохранить изменения</button>
                </div>
            </form>

            <div class="d-flex flex-wrap gap-2 mt-3">
                @if (string.Equals(Model.Property.Status, "Sold", StringComparison.OrdinalIgnoreCase))
                {
                    <form asp-action="Show" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="propertyId" value="@Model.Property.Id" />
                        <button type="submit" class="btn btn-outline-success">Активировать объект</button>
                    </form>
                }

                @if (string.Equals(Model.Property.Status, "Hidden", StringComparison.OrdinalIgnoreCase))
                {
                    <form asp-action="Show" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="propertyId" value="@Model.Property.Id" />
                        <button type="submit" class="btn btn-outline-success">Показать объект</button>
                    </form>
                }
                else if (!string.Equals(Model.Property.Status, "Sold", StringComparison.OrdinalIgnoreCase))
                {
                    <form asp-action="Hide" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="propertyId" value="@Model.Property.Id" />
                        <button type="submit" class="btn btn-outline-dark">Скрыть объект</button>
                    </form>
                }
            </div>
        </div>
    </section>

    <section class="card border-0 shadow-sm mb-3" id="criteriaSection">
        <div class="card-body p-4">
            <h2 class="h4 mb-3">Критерии объекта</h2>

            <form asp-action="UpsertCriterion" asp-route-id="@Model.Property.Id" method="post" id="criterionForm" class="row g-3 mb-4">
                @Html.AntiForgeryToken()
                <div class="col-md-6">
                    <label for="criterionDefinitionId" class="form-label">Критерий</label>
                    <div class="input-group">
                        <input type="text" id="criterionEditSelectedName" class="form-control" value="Критерий не выбран" readonly />
                        <button type="button" id="criterionEditOpenPickerButton" class="btn btn-outline-secondary">Выбрать</button>
                    </div>
                    <select id="criterionDefinitionId" name="criterionDefinitionId" class="d-none" required>
                        <option value="">Выберите критерий</option>
                        @foreach (var d in Model.CriterionDefinitions.OrderBy(x => x.DisplayName))
                        {
                            <option value="@d.Id">@d.DisplayName</option>
                        }
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Тип значения</label>
                    <input id="criterionValueTypeLabel" type="text" class="form-control" readonly value="Выберите критерий" />
                </div>
                <div class="col-12" id="criterionValueContainer">
                    <div class="text-muted small">После выбора критерия появится соответствующий ввод значения.</div>
                </div>
                <div class="col-12 d-flex gap-2">
                    <button type="submit" class="btn btn-outline-primary">Сохранить критерий</button>
                    <button type="button" class="btn btn-outline-secondary" id="criterionFormReset">Очистить</button>
                </div>
            </form>

            @if (Model.CurrentCriteria.Count == 0)
            {
                <div class="alert alert-light border mb-0">У объекта пока нет заполненных критериев.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Критерий</th>
                                <th>Тип</th>
                                <th>Значение</th>
                                <th>Действия</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.CurrentCriteria.OrderBy(x => x.DisplayName))
                            {
                                <tr>
                                    <td>@item.DisplayName</td>
                                    <td>@PropertyValueDisplay.CriterionValueType(item.ValueType)</td>
                                    <td>@PropertyValueDisplay.CriterionValue(item.RawValue, item.ValueType)</td>
                                    <td>
                                        <div class="d-flex flex-wrap gap-2">
                                            <button type="button"
                                                    class="btn btn-outline-primary btn-sm js-edit-criterion"
                                                    data-definition-id="@item.CriterionDefinitionId"
                                                    data-value-type="@item.ValueType"
                                                    data-raw-value="@item.RawValue">
                                                Изменить
                                            </button>
                                            <form asp-action="DeleteCriterion" asp-route-id="@Model.Property.Id" method="post" onsubmit="return confirm('Удалить критерий у объекта?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="criterionDefinitionId" value="@item.CriterionDefinitionId" />
                                                <button type="submit" class="btn btn-outline-danger btn-sm">Удалить</button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </section>
}

<!-- Client Search Modal -->
<div class="modal fade" id="clientSearchModal" tabindex="-1" aria-labelledby="clientSearchModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title fs-5" id="clientSearchModalLabel">Выбор клиента</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
            </div>
            <div class="modal-body">
                <input type="text" id="clientSearchInput" class="form-control mb-3" placeholder="Поиск: ФИО, Email, Телефон..." />
                <div id="clientSearchLoading" class="text-center d-none">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Загрузка...</span>
                    </div>
                </div>
                <div id="clientPickerList" class="list-group"></div>
                <nav class="mt-3" aria-label="Страницы клиентов">
                    <ul id="clientPickerPagination" class="pagination pagination-sm mb-0 justify-content-center"></ul>
                </nav>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="criterionEditPickerModal" tabindex="-1" aria-labelledby="criterionEditPickerModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title fs-5" id="criterionEditPickerModalLabel">Выбор критерия</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
            </div>
            <div class="modal-body">
                <input type="text" id="criterionEditSearchInput" class="form-control mb-3" placeholder="Поиск: код, название, категория..." />
                <div class="mb-3">
                    <label class="form-label" for="criterionEditCategoryFilter">Категория</label>
                    <select id="criterionEditCategoryFilter" class="form-select">
                        <option value="">Не важно</option>
                    </select>
                </div>
                <div id="criterionEditPickerList" class="list-group"></div>
                <nav class="mt-3" aria-label="Страницы критериев">
                    <ul id="criterionEditPickerPagination" class="pagination pagination-sm mb-0 justify-content-center"></ul>
                </nav>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
}

@section Scripts {
    @if (Model.Property is not null)
    {
        <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
        <script src="~/js/explicit-submit-form.js" asp-append-version="true"></script>
        <script src="~/js/real-estate-form-map.js" asp-append-version="true"></script>
        <script src="~/js/real-estate-photo-editor.js" asp-append-version="true"></script>
        <script src="~/js/real-estate-criteria.js" asp-append-version="true"></script>
        <script>
            window.realEstateFormMapInit({
                mapElementId: "propertyMap",
                latitudeInputId: "latitudeInput",
                longitudeInputId: "longitudeInput",
                addressInputId: "addressInput",
                searchButtonId: "searchAddressButton",
                statusElementId: "mapStatusText",
                defaultLatitude: @Model.Property.Latitude.ToString("0.######", System.Globalization.CultureInfo.InvariantCulture),
                defaultLongitude: @Model.Property.Longitude.ToString("0.######", System.Globalization.CultureInfo.InvariantCulture)
            });
            window.realEstatePhotoEditorInit({
                photosListId: "existingPhotosList",
                retainInputsContainerId: "retainPhotoInputs",
                retainedCountId: "retainedPhotosCount"
            });
            const criteriaInit = @Html.Raw(criteriaInitJson);
            criteriaInit.criterionSearchInputId = "criterionEditSearchInput";
            criteriaInit.criterionCategoryFilterId = "criterionEditCategoryFilter";
            criteriaInit.criterionPickerListId = "criterionEditPickerList";
            criteriaInit.criterionPickerPaginationId = "criterionEditPickerPagination";
            criteriaInit.criterionPickerModalId = "criterionEditPickerModal";
            criteriaInit.criterionOpenPickerButtonId = "criterionEditOpenPickerButton";
            criteriaInit.criterionSelectedNameId = "criterionEditSelectedName";
            criteriaInit.criteriaJsonInputId = "criteriaJson";
            criteriaInit.updateFormId = "realEstateEditForm";
            window.realEstateCriteriaInit(criteriaInit);
        </script>
        <script src="~/js/real-estate-client-picker.js" asp-append-version="true"></script>
    }
}

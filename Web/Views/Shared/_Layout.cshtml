<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Real Estate</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Web.styles.css" asp-append-version="true" />
    <link rel="icon" type="image/png" href="~/favicon.png" asp-append-version="true" />
    <link rel="shortcut icon" href="~/favicon.ico" asp-append-version="true" />
    <link rel="apple-touch-icon" href="~/apple-touch-icon.png" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-xl navbar-light bg-white border-bottom box-shadow fixed-top">
            <div class="container navbar-shell">
                <a class="navbar-brand fw-bold text-primary order-1" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-house-door-fill me-1"></i> Real Estate
                </a>

                <div class="navbar-actions order-2 order-xl-3">
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <button class="notification-bell"
                                type="button"
                                data-bs-toggle="offcanvas"
                                data-bs-target="#notificationBellPanel"
                                aria-controls="notificationBellPanel"
                                title="Уведомления">
                            <i class="bi bi-bell"></i>
                            <span id="bellUnreadDot" class="notification-bell-dot d-none" aria-hidden="true"></span>
                        </button>
                        <a asp-controller="Profile" asp-action="Index" class="btn btn-outline-primary btn-sm navbar-profile-link d-none d-xl-inline-flex">Аккаунт</a>
                        <span class="text-muted navbar-user-name d-none d-xl-inline-block">@User.Identity.Name</span>
                        <form asp-controller="Auth" asp-action="Logout" method="post" class="m-0 d-none d-xl-block">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-danger btn-sm">Выйти</button>
                        </form>
                    }
                    else
                    {
                        <a class="btn btn-primary btn-sm" asp-controller="Auth" asp-action="Login">Войти</a>
                        <a class="btn btn-outline-primary btn-sm" asp-controller="Auth" asp-action="Register">Регистрация</a>
                    }
                </div>

                <button class="navbar-toggler order-3" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse order-4 order-xl-2" id="mainNavbar">
                    <ul class="navbar-nav align-items-xl-center">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Главная</a>
                        </li>

                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            @if (User.IsInRole("Client"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Matching" asp-action="Index">Подбор недвижимости</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="DealCenter" asp-action="Index">Сделки и связь</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="SellProperty" asp-action="Index">Продать недвижимость</a>
                                </li>
                            }

                            @if (User.IsInRole("Realtor") || User.IsInRole("Admin") || User.IsInRole("SuperAdmin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Matching" asp-action="Index">Подбор недвижимости</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="RealEstate" asp-action="Index">Недвижимость</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="DealRequests" asp-action="Index">Заявки</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Analytics" asp-action="Index">Аналитика</a>
                                </li>
                            }

                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Realtors" asp-action="Index">Риелторы</a>
                            </li>

                            @if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark fw-bold text-danger" asp-controller="Admin" asp-action="SystemSettings">Админ панель</a>
                                </li>
                            }

                            <li class="nav-item d-xl-none">
                                <a class="nav-link text-primary" asp-controller="Profile" asp-action="Index">Аккаунт</a>
                            </li>
                            <li class="nav-item d-xl-none">
                                <form asp-controller="Auth" asp-action="Logout" method="post" class="m-0">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="nav-link text-danger border-0 bg-transparent w-100 text-start">Выйти</button>
                                </form>
                            </li>
                        }
                    </ul>

                </div>
            </div>
        </nav>
    </header>

    <div class="container app-main-container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        <div class="offcanvas offcanvas-end notification-offcanvas" tabindex="-1" id="notificationBellPanel" aria-labelledby="notificationBellPanelLabel" data-bs-scroll="true">
            <div class="offcanvas-header">
                <h5 class="offcanvas-title" id="notificationBellPanelLabel">
                    <i class="bi bi-bell me-1"></i> Уведомления
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Закрыть"></button>
            </div>
            <div class="offcanvas-body">
                <div id="bellNotificationsContainer" class="d-grid gap-2">
                    <div class="small text-muted">Загрузка...</div>
                </div>
            </div>
        </div>
    }

    <footer class="site-footer mt-5">
        <div class="container">
            <div class="site-footer-main">
                <div class="site-footer-brand">
                    <a class="site-footer-logo" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-house-door-fill"></i>
                        <span>Real Estate</span>
                    </a>
                    <div class="site-footer-text">Агентство недвижимости для подбора объектов, заявок и сопровождения сделок.</div>
                </div>

                <nav class="site-footer-links" aria-label="Нижняя навигация">
                    <a asp-controller="Home" asp-action="Index">Главная</a>
                    <a asp-controller="Matching" asp-action="Index">Подбор недвижимости</a>
                    <a asp-controller="Realtors" asp-action="Index">Риелторы</a>
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        @if (User.IsInRole("Client"))
                        {
                            <a asp-controller="DealCenter" asp-action="Index">Сделки и связь</a>
                            <a asp-controller="SellProperty" asp-action="Index">Продать недвижимость</a>
                        }

                        @if (User.IsInRole("Realtor") || User.IsInRole("Admin") || User.IsInRole("SuperAdmin"))
                        {
                            <a asp-controller="RealEstate" asp-action="Index">Недвижимость</a>
                            <a asp-controller="DealRequests" asp-action="Index">Заявки</a>
                        }

                        @if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin"))
                        {
                            <a asp-controller="Admin" asp-action="SystemSettings">Админ панель</a>
                        }
                    }
                </nav>

                <div class="site-footer-actions">
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <a class="site-footer-account" asp-controller="Profile" asp-action="Index">
                            <i class="bi bi-person-circle"></i>
                            <span>Аккаунт</span>
                        </a>
                    }
                    else
                    {
                        <a class="site-footer-account" asp-controller="Auth" asp-action="Login">
                            <i class="bi bi-box-arrow-in-right"></i>
                            <span>Войти</span>
                        </a>
                    }
                </div>
            </div>

            <div class="site-footer-bottom">
                <span>&copy; 2026 Real Estate Agency</span>
                <span>Веб-приложение агентства недвижимости</span>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        <script src="~/js/notification-bell.js" asp-append-version="true"></script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@model Web.Models.DealCenter.DealComplaintPageViewModel
@using Web.Models.Dashboard
@{
    ViewData["Title"] = "Жалоба";
}

<section class="mb-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
        <h1 class="h2 mb-0">Отправить жалобу</h1>
        <a href="@Model.BackUrl" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Назад
        </a>
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
{
    <div class="alert alert-success" role="alert">@Model.SuccessMessage</div>
}

@if (Model.ApiError is not null)
{
    <partial name="_ApiErrorAlert" model="Model.ApiError" />
}

<div class="row g-3">
    <div class="col-lg-8">
        <section class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <h2 class="h5 mb-3">Детали обращения</h2>

                <form asp-action="SubmitComplaintFromPage" method="post" class="row g-3">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="dealId" value="@Model.DealId" />
                    <input type="hidden" name="propertyId" value="@Model.PropertyId" />
                    <input type="hidden" name="source" value="@Model.Source" />
                    <input type="hidden" name="scope" value="@Model.Scope" />
                    <input type="hidden" name="search" value="@Model.Search" />
                    <input type="hidden" name="status" value="@Model.Status" />
                    <input type="hidden" name="returnUrl" value="@Model.BackUrl" />

                    <div class="col-12">
                        <label class="form-label">Категория</label>
                        @if (Model.IsCategoryLocked)
                        {
                            <div class="form-control" readonly>
                                @DashboardValueDisplay.ComplaintCategory(Model.CategoryOptions[0].Value)
                            </div>
                            <input type="hidden" name="category" value="@Model.CategoryOptions[0].Value" />
                        }
                        else
                        {
                            <select class="form-select" name="category" required>
                                @foreach (var option in Model.CategoryOptions)
                                {
                                    <option value="@option.Value" selected="@(string.Equals(Model.Category, option.Value, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">
                                        @option.Label
                                    </option>
                                }
                            </select>
                        }
                    </div>

                    <div class="col-12">
                        <label class="form-label">Тема</label>
                        <div class="form-control" readonly>@Model.Subject</div>
                        <input type="hidden" name="subject" value="@Model.Subject" />
                    </div>

                    <div class="col-12">
                        <label class="form-label">Описание</label>
                        <textarea class="form-control" style="resize: none; overflow-y: auto;" name="description" rows="6" maxlength="4000" placeholder="Опишите проблему максимально конкретно" required>@Model.Description</textarea>
                    </div>

                    <div class="col-12 d-flex gap-2">
                        <button type="submit" class="btn btn-danger">Отправить жалобу</button>
                        <a href="@Model.BackUrl" class="btn btn-outline-secondary">Отмена</a>
                    </div>
                </form>
            </div>
        </section>
    </div>

    <div class="col-lg-4">
        <section class="card border-0 shadow-sm h-100">
            <div class="card-body p-4">
                <h2 class="h6 text-uppercase text-muted">Контекст</h2>
                @if (Model.Deal is not null)
                {
                    <div class="small text-muted">Сделка</div>
                    <div class="mb-2 text-break">@Model.Deal.Id</div>
                    <div class="small text-muted">Тип</div>
                    <div class="mb-2">@(string.Equals(Model.Deal.Source, "Sale", StringComparison.OrdinalIgnoreCase) ? "Продажа" : "Покупка")</div>
                    <div class="small text-muted">Объект</div>
                    <div class="mb-2">@(string.IsNullOrWhiteSpace(Model.Deal.PropertyTitle) ? "Объект в обработке" : Model.Deal.PropertyTitle)</div>
                    <div class="small text-muted">Риелтор</div>
                    <div>@(string.IsNullOrWhiteSpace(Model.Deal.RealtorFullName) ? "Не назначен" : Model.Deal.RealtorFullName)</div>
                }
                else if (Model.Property is not null)
                {
                    <div class="small text-muted">Объект</div>
                    <div class="mb-2">@Model.Property.Title</div>
                    <div class="small text-muted">Адрес</div>
                    <div>@Model.Property.Address</div>
                }
                else
                {
                    <div class="text-muted">Общая жалоба без привязки к сделке.</div>
                }
            </div>
        </section>
    </div>
</div>
@model Web.Models.DealCenter.DealCenterIndexViewModel
@using Web.Models.DealRequests
@{
    ViewData["Title"] = "Сделки и связь";
    var statuses = new[] { "Created", "InProgress", "Completed", "Cancelled" };
}

<section class="mb-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
        <h1 class="h2 mb-0">Сделки и связь</h1>
        <span class="text-muted small">Сделок: @Model.Items.Count</span>
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
{
    <div class="alert alert-success" role="alert">@Model.SuccessMessage</div>
}

@if (Model.ApiError is not null)
{
    <partial name="_ApiErrorAlert" model="Model.ApiError" />
}

<section class="card border-0 shadow-sm mb-3">
    <div class="card-body p-4">
        <ul class="nav nav-pills mb-3">
            <li class="nav-item">
                <a class="nav-link @(Model.Scope == "purchase" ? "active" : null)"
                   asp-action="Index"
                   asp-route-scope="purchase"
                   asp-route-search="@Model.Search"
                   asp-route-status="@Model.Status">Покупка</a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(Model.Scope == "sale" ? "active" : null)"
                   asp-action="Index"
                   asp-route-scope="sale"
                   asp-route-search="@Model.Search"
                   asp-route-status="@Model.Status">Продажа</a>
            </li>
        </ul>

        <form asp-action="Index" method="get" class="row g-2 align-items-end">
            <input type="hidden" name="scope" value="@Model.Scope" />
            <div class="col-md-6">
                <label class="form-label">Поиск</label>
                <input type="text" class="form-control" name="search" value="@Model.Search" placeholder="Объект, риелтор, комментарий" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Статус</label>
                <select class="form-select" name="status">
                    <option value="">Все</option>
                    @foreach (var status in statuses)
                    {
                        <option value="@status" selected="@(string.Equals(status, Model.Status, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">
                            @DealRequestValueDisplay.Status(status)
                        </option>
                    }
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-outline-primary w-100">Применить</button>
                <a asp-action="Index" asp-route-scope="@Model.Scope" class="btn btn-outline-secondary">Сброс</a>
            </div>
        </form>
    </div>
</section>

<section class="card border-0 shadow-sm">
    <div class="card-body p-4">
        @if (Model.Items.Count == 0)
        {
            <div class="alert alert-light border mb-0">Сделки не найдены.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Объект</th>
                            <th>Риелтор</th>
                            <th>Статус</th>
                            <th>Дата</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items.OrderByDescending(x => x.CreatedDate))
                        {
                            var unreadCount = Model.GetUnreadCount(item.Id);
                            <tr>
                                <td>@(string.IsNullOrWhiteSpace(item.PropertyTitle) ? "Объект в обработке" : item.PropertyTitle)</td>
                                <td>@(string.IsNullOrWhiteSpace(item.RealtorFullName) ? "Не назначен" : item.RealtorFullName)</td>
                                <td>
                                    <span class="badge rounded-pill @DealRequestValueDisplay.StatusBadgeClass(item.Status)">
                                        @DealRequestValueDisplay.Status(item.Status)
                                    </span>
                                </td>
                                <td class="text-nowrap">@item.CreatedDate.ToString("dd.MM.yyyy HH:mm")</td>
                                <td class="text-nowrap">
                                    <a asp-action="Details"
                                       asp-route-id="@item.Id"
                                       asp-route-scope="@Model.Scope"
                                       asp-route-search="@Model.Search"
                                       asp-route-status="@Model.Status"
                                       class="btn btn-outline-primary btn-sm">Открыть</a>
                                    @if (unreadCount > 0)
                                    {
                                        <span class="badge rounded-pill text-bg-primary ms-2" title="Есть непрочитанные сообщения">
                                            @unreadCount
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>

@model Web.Models.Realtors.RealtorsIndexViewModel
@{
    ViewData["Title"] = "Риелторы";
    const string defaultAvatar = "/images/realtor-default-avatar.svg";
}

<section class="mb-4">
    <h1 class="h2 mb-1">Риелторы агентства</h1>
    <div class="text-muted">Лучшие специалисты и общий каталог для быстрого поиска.</div>
</section>

@if (Model.ApiError is not null)
{
    <partial name="_ApiErrorAlert" model="Model.ApiError" />
}

<section class="mb-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-2 mb-3">
        <div>
            <h2 class="h4 mb-1">Топ риелторы</h2>
            <div class="text-muted small">Шесть специалистов с лучшим рейтингом.</div>
        </div>
    </div>

    @if (Model.TopRealtors.Count == 0)
    {
        <div class="alert alert-light border mb-0">Пока нет данных для блока топ.</div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var realtor in Model.TopRealtors)
            {
                var avatar = string.IsNullOrWhiteSpace(realtor.AvatarPath) ? defaultAvatar : realtor.AvatarPath;
                <div class="col-md-6 col-xl-4">
                    <article class="card border-0 shadow-sm h-100 realtor-card">
                        <div class="card-body p-3">
                            <div class="d-flex align-items-center gap-3 mb-3">
                                <img src="@avatar" alt="Фото риелтора" class="rounded-circle border" style="width: 64px; height: 64px; object-fit: cover;" />
                                <div class="min-w-0">
                                    <h3 class="h6 mb-1">@realtor.FullName</h3>
                                    <div class="small text-muted">@realtor.PhoneNumber</div>
                                </div>
                            </div>

                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="small text-muted">Рейтинг</span>
                                @if (realtor.AverageRating > 0)
                                {
                                    <span class="fw-semibold text-primary">@realtor.AverageRating.ToString("N2") / 5.00</span>
                                }
                                else
                                {
                                    <span class="text-muted small">Нет оценки</span>
                                }
                            </div>
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span class="small text-muted">Сделок за месяц</span>
                                <span class="fw-semibold">@realtor.DealsThisMonth</span>
                            </div>

                            @if (User.IsInRole("Admin"))
                            {
                                <a asp-controller="Admin" asp-action="RealtorAnalytics" asp-route-realtorId="@realtor.Id" class="btn btn-outline-secondary btn-sm">
                                    Эффективность
                                </a>
                            }
                        </div>
                    </article>
                </div>
            }
        </div>
    }
</section>

<section>
    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-end gap-3 mb-3">
        <div>
            <h2 class="h4 mb-1">Все риелторы</h2>
            <div class="text-muted small">
                Найдено: @Model.TotalCount
            </div>
        </div>

        <form asp-action="Index" method="get" class="realtor-search-form">
            <div class="input-group">
                <input type="search"
                       name="search"
                       value="@Model.SearchQuery"
                       class="form-control"
                       placeholder="ФИО или телефон" />
                <button class="btn btn-primary" type="submit">
                    <i class="bi bi-search"></i>
                    <span class="d-none d-sm-inline ms-1">Найти</span>
                </button>
                @if (!string.IsNullOrWhiteSpace(Model.SearchQuery))
                {
                    <a asp-action="Index" class="btn btn-outline-secondary">Сброс</a>
                }
            </div>
        </form>
    </div>

    @if (Model.Realtors.Count == 0)
    {
        <div class="alert alert-light border mb-0">По этому запросу риелторы не найдены.</div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var realtor in Model.Realtors)
            {
                var avatar = string.IsNullOrWhiteSpace(realtor.AvatarPath) ? defaultAvatar : realtor.AvatarPath;
                <div class="col-md-6 col-xl-4">
                    <article class="card border-0 shadow-sm h-100 realtor-card">
                        <div class="card-body p-3">
                            <div class="d-flex align-items-center gap-3 mb-3">
                                <img src="@avatar" alt="Фото риелтора" class="rounded-circle border" style="width: 64px; height: 64px; object-fit: cover;" />
                                <div class="min-w-0">
                                    <h3 class="h6 mb-1">@realtor.FullName</h3>
                                    <div class="small text-muted">@realtor.PhoneNumber</div>
                                </div>
                            </div>

                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="small text-muted">Рейтинг</span>
                                @if (realtor.AverageRating > 0)
                                {
                                    <span class="fw-semibold text-primary">@realtor.AverageRating.ToString("N2") / 5.00</span>
                                }
                                else
                                {
                                    <span class="text-muted small">Нет оценки</span>
                                }
                            </div>
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span class="small text-muted">Сделок за месяц</span>
                                <span class="fw-semibold">@realtor.DealsThisMonth</span>
                            </div>

                            @if (User.IsInRole("Admin"))
                            {
                                <a asp-controller="Admin" asp-action="RealtorAnalytics" asp-route-realtorId="@realtor.Id" class="btn btn-outline-secondary btn-sm">
                                    Эффективность
                                </a>
                            }
                        </div>
                    </article>
                </div>
            }
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav class="mt-4" aria-label="Страницы риелторов">
                <ul class="pagination justify-content-center mb-0">
                    <li class="page-item @(Model.Page <= 1 ? "disabled" : null)">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-search="@Model.SearchQuery"
                           asp-route-page="@(Model.Page - 1)">Назад</a>
                    </li>
                    @for (var p = 1; p <= Model.TotalPages; p++)
                    {
                        <li class="page-item @(p == Model.Page ? "active" : null)">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-search="@Model.SearchQuery"
                               asp-route-page="@p">@p</a>
                        </li>
                    }
                    <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : null)">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-search="@Model.SearchQuery"
                           asp-route-page="@(Model.Page + 1)">Вперёд</a>
                    </li>
                </ul>
            </nav>
        }
    }
</section>

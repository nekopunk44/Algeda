{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Enabled": false,
    "ForwardLimit": 1,
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "DataProtection": {
    "ApplicationName": "Algeda.Web",
    "KeysPath": null
  },
  "Api": {
    "BaseUrl": "http://localhost:5142",
    "TimeoutSeconds": 30
  },
  "ApiColdStartRecovery": {
    "Enabled": false,
    "MaxRetryAttempts": 4,
    "WakeupTimeoutSeconds": 15,
    "KeepApiAwakeIntervalMinutes": 0
  },
  "Pricing": {
    "BaseCurrencyCode": "USD",
    "CurrencySymbol": "$",
    "NumberCulture": "en-US"
  }
}

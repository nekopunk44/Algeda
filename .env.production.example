# Copy to .env.production. This file contains only non-secret settings and secret file paths.
COMPOSE_PROJECT_NAME=algeda

# Public DNS records must point to this server before Caddy is started.
WEB_HOSTNAME=algeda.example.com
API_HOSTNAME=api.algeda.example.com
ACME_EMAIL=ops@example.com

# Build/image identifiers. Use immutable registry tags or digests in real deployments.
ALGEDA_API_IMAGE=algeda-api
ALGEDA_WEB_IMAGE=algeda-web
ALGEDA_IMAGE_TAG=local
POSTGIS_IMAGE=postgis/postgis:18-3.6
CADDY_IMAGE=caddy:2.11.4-alpine

POSTGRES_DB=algeda
POSTGRES_USER=algeda
ALGEDA_APP_DB_USER=algeda_app
ALGEDA_MIGRATION_DB_USER=algeda_migrator

# Used only by the explicit `bootstrap-admin` operations profile.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_DISPLAY_NAME=Administrator

# SMTP over implicit TLS. Adjust these values for the selected provider.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=465
EMAIL_USER=mailer@example.com
EMAIL_FROM_ADDRESS=mailer@example.com
EMAIL_FROM_NAME=Algeda
EMAIL_USE_SSL=true

# Paths are resolved from the repository/Compose project directory.
# Each referenced file must contain exactly one secret value and a final newline.
POSTGRES_PASSWORD_FILE=./deploy/secrets/postgres_password
APP_DB_PASSWORD_FILE=./deploy/secrets/app_db_password
MIGRATION_DB_PASSWORD_FILE=./deploy/secrets/migration_db_password
API_CONNECTION_STRING_FILE=./deploy/secrets/api_connection_string
MIGRATION_CONNECTION_STRING_FILE=./deploy/secrets/migration_connection_string
JWT_SIGNING_KEY_FILE=./deploy/secrets/jwt_signing_key
EMAIL_PASSWORD_FILE=./deploy/secrets/email_password
AUTOMAPPER_LICENSE_KEY_FILE=./deploy/secrets/automapper_license_key
BOOTSTRAP_ADMIN_PASSWORD_FILE=./deploy/secrets/bootstrap_admin_password
